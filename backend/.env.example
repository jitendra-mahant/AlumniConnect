PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/alumniconnect
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alumniconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/alumniconnect

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Name of the college this deployment serves
COLLEGE_NAME=National Institute of Technology
