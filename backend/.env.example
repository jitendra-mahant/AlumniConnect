PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/db_alumini_years

# JWT configuration
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend / Application URL (allowed origin for CORS & Socket.IO in local dev)
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false

# Institution name and allowed email domain
COLLEGE_NAME="K.K. Wagh Institute of Engineering Education & Research (KKWAGH)"
ALLOWED_EMAIL_DOMAIN=kkwagh.edu.in

# SMTP Email Configuration (Nodemailer)
# For production: provide real SMTP credentials (e.g. Gmail App Password, SendGrid, Amazon SES)
# If left blank in development, emails are previewed in console / test logger


SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_exact_brevo_smtp_login
SMTP_PASS=your_generated_smtp_key
SMTP_FROM=your_verified_sender_email
SMTP_FROM_NAME=AlumniConnect

# OTP verification policy
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
