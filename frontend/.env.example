# AlumniConnect Frontend Environment Configuration

# Production backend API base URL (e.g. https://alumniconnect-jnop.onrender.com)
# Leave empty in local development so Vite proxies /api requests to http://localhost:5000.
VITE_API_URL=https://alumniconnect-jnop.onrender.com

# Production Socket.IO URL (optional).
# If omitted, automatically falls back to VITE_API_URL, or window.location.origin in dev.
VITE_SOCKET_URL=https://alumniconnect-jnop.onrender.com
